# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Storefronts ───────────────────────────────────────────────────────────────
GUMROAD_ACCESS_TOKEN=...

# Etsy — create app at https://www.etsy.com/developers/register
ETSY_KEYSTRING=...
ETSY_SHARED_SECRET=...

# Pinterest — create app at https://developers.pinterest.com/
PINTEREST_APP_ID=...
PINTEREST_APP_SECRET=...

# ── Database ─────────────────────────────────────────────────────────────────
# Free tier: https://supabase.com → new project → Settings → Database → URI
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
