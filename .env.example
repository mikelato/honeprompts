# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Lemon Squeezy (primary storefront) ───────────────────────────────────────
# Get API key: app.lemonsqueezy.com → Settings → API
# Store ID: app.lemonsqueezy.com → Settings → Stores → copy the numeric ID
LEMON_API_KEY=...
LEMON_STORE_ID=...

# ── Etsy (distribution channel) ───────────────────────────────────────────────
# Create app: https://www.etsy.com/developers/register
# Then run: python run.py content:etsy-auth  (OAuth flow)
ETSY_KEYSTRING=...
ETSY_SHARED_SECRET=...

# ── Pinterest (traffic channel) ───────────────────────────────────────────────
# Requires a verified website. Use gethone.co once live.
PINTEREST_APP_ID=...
PINTEREST_APP_SECRET=...

# ── Database ─────────────────────────────────────────────────────────────────
# Free tier: https://supabase.com → new project → Settings → Database → URI
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
